{
  "name": "dsh-llm-qianfan",
  "version": "0.3.0",
  "type": "module",
  "description": "Baidu Qianfan Token Plan provider route for the DeepSeek Harness LLM seam: streaming text, reasoning, tool calls, token usage, live model discovery, per-model reasoning-effort ladders, and a Token Plan usage readout (console quota + local meter) above the composer.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test verify/usage-meter.test.mjs verify/route.test.mjs verify/client.test.mjs verify/apply.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qianfan",
    "baidu",
    "llm",
    "provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daydream-wjh/dsh-llm-qianfan.git"
  },
  "homepage": "https://github.com/daydream-wjh/dsh-llm-qianfan#readme",
  "bugs": {
    "url": "https://github.com/daydream-wjh/dsh-llm-qianfan/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
