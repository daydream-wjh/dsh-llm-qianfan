    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qianfan",
    "baidu",
    "llm",
    "provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daydream-wjh/dsh-llm-qianfan.git"
  },
  "homepage": "https://github.com/daydream-wjh/dsh-llm-qianfan#readme",
  "bugs": {
    "url": "https://github.com/daydream-wjh/dsh-llm-qianfan/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
