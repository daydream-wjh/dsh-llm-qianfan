{
  "name": "dsh-llm-qianfan",
  "version": "1.0.1",
  "type": "module",
  "description": "Baidu Qianfan Token Plan provider route for the DeepSeek Harness LLM seam: adds a qianfan model route with streaming text, reasoning, tool calls and per-model reasoning-effort ladders.",
